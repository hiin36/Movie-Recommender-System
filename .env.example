# ==========================================
# .env - Biến môi trường dự án
# ==========================================
# Đổi tên file này thành .env và điền khóa API thực tế

# TMDB API Key (đăng ký tại https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Cấu hình mô hình
SVD_N_FACTORS=100
SVD_N_EPOCHS=20
SVD_LR=0.005
SVD_REG=0.02
HYBRID_ALPHA=0.6
